  "questions": [
   {
    "id": "Q01",
    "prompt": "What is the brand's legal name, headquarters address, and primary operations and sales contacts?",
    "topic": "brand_overview"
   },
   {
    "id": "Q02",
    "prompt": "Please list every active SKU with UPC, case pack, unit dimensions, and weight.",
    "topic": "sku_information"
   },
   {
    "id": "Q03",
    "prompt": "Which SKUs are new launches or planned discontinuations in the next 12 months?",
    "topic": "sku_information"
   },
   {
    "id": "Q04",
    "prompt": "What are the wholesale cost, MSRP, and MAP for each SKU, and when was pricing last changed?",
    "topic": "pricing"
   },
   {
    "id": "Q05",
    "prompt": "What are current on-hand inventory levels by SKU and typical weeks of supply?",
    "topic": "inventory_levels"
   },
   {
    "id": "Q06",
    "prompt": "How many retail doors carry the brand today, by account and region?",
    "topic": "door_count"
   },
   {
    "id": "Q07",
    "prompt": "What were annual net revenues for the last three years and the year-to-date trend by channel?",
    "topic": "revenue_trends"
   },
   {
    "id": "Q08",
    "prompt": "What promotions, discounts, or trade programs ran in the past 12 months and which are planned?",
    "topic": "promotional_activity"
   },
   {
    "id": "Q09",
    "prompt": "What marketing campaigns, budget, and launch support are planned for the next 12 months?",
    "topic": "marketing_plans"
   },
   {
    "id": "Q10",
    "prompt": "How is the sales team structured (internal reps, brokers, territories) and who manages key accounts?",
    "topic": "sales_team_structure"
   },
   {
    "id": "Q11",
    "prompt": "What are standard order lead times, EDI capabilities, and order fill rates?",
    "topic": "operational_capabilities"
   },
   {
    "id": "Q12",
    "prompt": "Where does product ship from, and what are freight terms and minimum order quantities?",
    "topic": "logistics"
   },
   {
    "id": "Q13",
    "prompt": "Which regulatory, labeling, insurance, and certification requirements does the brand meet?",
    "topic": "compliance_requirements"
   },
   {
    "id": "Q14",
    "prompt": "Who manufactures the products, what is available capacity, and are there backup suppliers?",
    "topic": "manufacturing_partnerships"
